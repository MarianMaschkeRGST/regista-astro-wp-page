# `astro dev`. Public config only: secrets belong in .env.
#
# Points at the shared demo backend on xserver, so development does not depend
# on the Local site running. Note that it is shared: content edits and the
# query log land where the demo's do.
WPGRAPHQL_URL = "https://regista.regista-demo.net/graphql"
PUBLIC_WP_URL = "regista.regista-demo.net"
WORDPRESS_API_ROOT_URL = "https://regista.regista-demo.net"

# The Local site, for working offline or on content structure. Swap these in
# and restart `astro dev`; Local has to be running.
# WPGRAPHQL_URL = "http://00regista-hp-2026.local/graphql"
# PUBLIC_WP_URL = "00regista-hp-2026.local"
# WORDPRESS_API_ROOT_URL = "http://00regista-hp-2026.local"
