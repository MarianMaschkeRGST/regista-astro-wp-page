---
import BlockRenderer from "../components/BlockRenderer.astro";
import Layout from "../layouts/Layout.astro";

import type { Block } from "@wp-block-tools/styles";
type Seo = { metaDesc: string; title: string };
type PageResult = {
  data: {
    pages: {
      nodes: { id: string; title: string; blocks: Block[]; seo: Seo }[];
    };
  };
};

export const prerender = false;

const response = await fetch(`${import.meta.env.WPGRAPHQL_URL}`, {
  method: "POST",
  headers: { "Content-Type": "application/json" },
  body: JSON.stringify({
    query: `
	query ProjectsPageQuery($name : String!) {
		pages(where: { name: $name }) {
			nodes {
				id
				title
				blocks(postTemplate: false)
				seo {
					metaDesc
					title
				}
			}
		}
	}`,
    variables: {
      name: "projects",
    },
  }),
});
if (!response.ok) {
  throw new Error(
    `WPGraphQL request failed: ${response.status} ${await response.text()}`,
  );
}

const { data } = (await response.json()) as PageResult;
const page = data.pages.nodes[0];
const blocks = page?.blocks ?? [];
const seo = page?.seo ?? { metaDesc: "", title: "" };
---

<Layout seo={seo}>
  <main>
    {page?.title && <h1>{page.title}</h1>}
    <BlockRenderer blocks={blocks} />
  </main>
</Layout>
