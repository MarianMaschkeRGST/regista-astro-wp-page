---
import BlockRenderer from "../components/BlockRenderer.astro";
import Layout from "../layouts/Layout.astro";
import NotFound from "../components/NotFound.astro";
import { fetchContentNode } from "../lib/wordpress";

import type { Block } from "@wp-block-tools/styles";

/**
 * The unified template: every WordPress page, post and custom post type is
 * rendered from the block theme's template, so a member, a note or a method
 * has a page without anything being added here.
 *
 * The page is the post's own title and content blocks: WordPress serves no
 * template of its own here, it only holds the content.
 *
 * A content type that needs more than its blocks gets its own route file —
 * src/pages/projects.astro, or src/pages/projects/[slug].astro — which Astro
 * matches before this catch-all.
 *
 * Rendered per request rather than prerendered: new WordPress content is live
 * without a rebuild, and the build no longer needs WordPress to be reachable.
 */
export const prerender = false;

const node = await fetchContentNode(Astro.url.pathname);
if (!node) {
  Astro.response.status = 404;
}

const seo = node?.seo ?? {
  title: "404 — Page not found",
  metaDesc: "The page you requested could not be found.",
};
---

<Layout seo={seo}>
  {
    node ? (
      <main data-content-type={node.typeName}>
        {node.title && <h1>{node.title}</h1>}
        <BlockRenderer blocks={node.blocks as Block[]} />
      </main>
    ) : (
      <NotFound />
    )
  }
</Layout>
