---
import {
  faFacebook,
  faInstagram,
  faYoutube,
} from "@fortawesome/free-brands-svg-icons";
import { FontAwesomeIcon } from "@fortawesome/react-fontawesome";
import { joinClasses } from "../utils/joinClasses";

type Props = {
  styles: string;
  classes: string;
  url?: string;
  service?: string;
};
const { styles, classes, url, service } = Astro.props;
const brandColor = () => {
  switch (service) {
    case "facebook":
      return "hover:text-[#1877F2]";
    case "instagram":
      return "hover:text-[#E4405F]";
    case "youtube":
      return "hover:text-[#FF0000]";
    default:
      return "hover:text-white";
  }
};
const linkClasses = joinClasses(classes, "text-3xl", brandColor());
---

<a href={url} target="_blank" rel="nofollow" class={linkClasses} style={styles}>
  {service === "facebook" && <FontAwesomeIcon icon={faFacebook} />}
  {service === "instagram" && <FontAwesomeIcon icon={faInstagram} />}
  {service === "youtube" && <FontAwesomeIcon icon={faYoutube} />}
</a>
