---
import { joinClasses } from "../utils/joinClasses";
import { replaceUrls } from "../utils/replaceUrls";

type Props = {
  styles: string;
  classes: string;
  url?: string;
  content: string;
};

const { styles, classes, url, content } = Astro.props;
const href = replaceUrls(url || "#", Astro.url.host);
// Set default button classes
const buttonClasses = joinClasses(
  "inline-block uppercase font-bold tracking-[1.3px] bg-blast-off rounded-full py-3 px-6",
  classes,
);
---

<a href={href} class={buttonClasses} style={styles}>{content}</a>
