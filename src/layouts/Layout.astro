---
import CommonHead from "../components/CommonHead.astro";

type Props = {
  seo: {
    title: string;
    metaDesc: string;
  };
};

const { seo } = Astro.props;
---

<!doctype html>
<html lang="en">
  <CommonHead title={seo.title} description={seo.metaDesc} />
  <body>
    <slot />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>
